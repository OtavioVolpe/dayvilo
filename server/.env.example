HOST=127.0.0.1
PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dayvilo_app
MYSQL_PASSWORD=
MYSQL_DATABASE=dayvilo
# Opcional: necessário apenas para vincular um perfil criado antes do cadastro de contas.
USUARIO_LOCAL_ID=

# Endereço fixo da interface para os links de recuperação (não derivado da requisição).
URL_APLICACAO=http://127.0.0.1:5173/

# local salva arquivos; resend envia pela internet.
EMAIL_MODO=local
RESEND_API_KEY=
EMAIL_REMETENTE="Dayvilo <onboarding@resend.dev>"
# Obrigatório com resend.dev: e-mail usado na conta Resend. Não redireciona outras contas.
RESEND_DESTINATARIO_TESTE=

# Produção: configurar no painel de hospedagem, sem publicar credenciais.
# NODE_ENV=production
# HOST=0.0.0.0
# URL_APLICACAO=https://seu-site.onrender.com/
# PROXY_SALTOS=1 apenas com um proxy confiável e sem acesso direto ao Node.
# PROXY_SALTOS=1
# Em produção, cadastro fechado por padrão. Sua conta existente continua acessível.
# CADASTRO_ABERTO=false
# TLS obrigatório em produção; use o hostname fornecido pelo banco.
# MYSQL_SSL=true
# Certificado CA: conteúdo PEM na variável OU caminho de arquivo privado.
# MYSQL_SSL_CA_FILE=/caminho/privado/ca.pem
