{
  "name": "dayvilo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:backup:online": "node server/scripts/backup-online.js",
    "db:backup:verificar": "node server/scripts/verificar-backup.js",
    "db:check": "node --env-file-if-exists=server/.env server/scripts/check-db.js",
    "db:migrate": "node --env-file-if-exists=server/.env server/scripts/migrate.js",
    "emails:listar": "node server/scripts/listar-emails.js",
    "conta:codigo": "node --env-file-if-exists=server/.env server/scripts/codigo-vinculo.js",
    "db:perfil": "node --env-file-if-exists=server/.env server/scripts/preparar-perfil.js",
    "test:integracao": "node --env-file-if-exists=server/.env --test --test-isolation=none server/test/*.integration.js",
    "test": "node --test --test-isolation=none server/test/*.test.js"
  },
  "devDependencies": { "concurrently": "10.0.5" }
}

